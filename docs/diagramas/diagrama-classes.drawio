        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Cliente {\n    +int id &lt;&lt;PK&gt;&gt;\n    +String cpf\n    +String nome\n    +String telefone\n    +String email\n    +String senha\n    +atualizarDados() void\n  }\n\n  class FuncionarioOficina {\n    +int id &lt;&lt;PK&gt;&gt;\n    +String cpf\n    +String nome\n    +String cargo\n    +String senha\n    +autenticar() boolean\n  }\n\n  class Veiculo {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int clienteId &lt;&lt;FK&gt;&gt;\n    +String placa\n    +String marca\n    +String modelo\n    +int ano\n    +int quilometragem\n    +atualizarKm() void\n  }\n\n  class Solicitacao {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int clienteId &lt;&lt;FK&gt;&gt;\n    +int veiculoId &lt;&lt;FK&gt;&gt;\n    +String servico\n    +String descricao\n    +LocalDate data\n    +int quantidadeFotos\n    +String status\n    +alterarStatus() void\n  }\n\n  class Orcamento {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int solicitacaoId &lt;&lt;FK&gt;&gt;\n    +String servico\n    +String descricao\n    +BigDecimal subtotalPecas\n    +BigDecimal subtotalMaoObra\n    +BigDecimal valorTotal\n    +BigDecimal valorAprovado\n    +String prazo\n    +String observacoes\n    +String status\n    +LocalDate data\n    +calcularTotal() BigDecimal\n  }\n\n  class ItemPeca {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int orcamentoId &lt;&lt;FK&gt;&gt;\n    +String nome\n    +String descricao\n    +int quantidade\n    +BigDecimal valorUnitario\n    +BigDecimal valorTotal\n    +Boolean aprovado\n    +calcularTotal() BigDecimal\n  }\n\n  class ItemMaoObra {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int orcamentoId &lt;&lt;FK&gt;&gt;\n    +String descricao\n    +int quantidade\n    +BigDecimal valorUnitario\n    +BigDecimal valorTotal\n    +Boolean aprovado\n    +calcularTotal() BigDecimal\n  }\n\n  class OrdemServico {\n    +int id &lt;&lt;PK&gt;&gt;\n    +int solicitacaoId &lt;&lt;FK&gt;&gt;\n    +int veiculoId &lt;&lt;FK&gt;&gt;\n    +String numeroOrdem\n    +String servico\n    +LocalDate dataEntrada\n    +LocalDate dataPrevisao\n    +LocalDate dataConclusao\n    +BigDecimal valor\n    +String status\n    +alterarStatus() void\n    +concluir() void\n  }\n\n  Cliente \&quot;1\&quot; --&gt; \&quot;0..N\&quot; Veiculo\n  Cliente \&quot;1\&quot; --&gt; \&quot;0..N\&quot; Solicitacao\n  Veiculo \&quot;1\&quot; --&gt; \&quot;0..N\&quot; Solicitacao\n  Solicitacao \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Orcamento\n  Orcamento \&quot;1\&quot; --&gt; \&quot;0..N\&quot; ItemPeca\n  Orcamento \&quot;1\&quot; --&gt; \&quot;0..N\&quot; ItemMaoObra\n  Solicitacao \&quot;1\&quot; --&gt; \&quot;0..1\&quot; OrdemServico\n  Veiculo \&quot;1\&quot; --&gt; \&quot;0..N\&quot; OrdemServico&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_SdDwmnH1ZYtck3vl2XN-114">
